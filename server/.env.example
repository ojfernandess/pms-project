# Supabase (servidor: service role para dados; anon só para validar JWT)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Opcional: base de functions legadas (default: ${SUPABASE_URL}/functions/v1)
FUNCTIONS_INVOKE_BASE_URL=

# Servidor
PORT=8787
NODE_ENV=development

# CORS: uma origem ou * (ex.: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
