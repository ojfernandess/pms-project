# Copie para .env na raiz (Docker Compose local / stack única Easypanel).
# Deploy modular (serviços separados): use deploy/env/*.env.example por serviço.
# Não commitar segredos.

# --- Build do frontend (obrigatório no rebuild da imagem) ---
# Compose Easypanel (recomendado): mesma URL do frontend — o nginx do contentor faz proxy para backend:3000.
VITE_PMS_API_URL=https://app.seudominio.com
VITE_APP_URL=https://app.seudominio.com
# Só se o browser falar com a API noutro domínio (ex. api.seudominio.com): defina PUBLIC_APP_URL no backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Backend + worker (runtime) ---
# Produção: pooler Supabase :5432 até concluir o dump para Postgres próprio (docs/migration/postgres-dump-auth-config.md).
# Local com compose --profile local-db: postgresql://pms:pms@postgres:5432/pms
DATABASE_URL=postgresql://pms:pms@postgres:5432/pms
# Supabase/prod já com schema: false (evita Prisma P3005). Postgres vazio local: true
PRISMA_MIGRATE_ON_START=false

# Só para scripts scripts/migration/dump-supabase-core.* (não commitar)
# SOURCE_DATABASE_URL=
# TARGET_DATABASE_URL=
REDIS_URL=redis://redis:6379
# Frontend runtime (proxy nginx para API na rede interna)
BACKEND_UPSTREAM=http://backend:3000
JWT_SECRET=troque-por-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
SOCKET_AUTH_TOKEN=
INTERNAL_API_TOKEN=
PUBLIC_APP_URL=https://app.seudominio.com
SITE_URL=https://app.seudominio.com
# Opcional: CORS explícito se VITE_PMS_API_URL for outro host (lista separada por vírgulas)
# CORS_ORIGINS=https://app.seudominio.com,https://sandbox.seudominio.com

# Opcional: jobs Aiosell/Channex com bearer de serviço
# SUPABASE_SERVICE_ROLE_KEY=

# Postgres interno (só se usar o contentor postgres do compose)
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms
POSTGRES_DB=pms
