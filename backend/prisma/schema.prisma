/// Tabela operacional do backend. Ainda não existe na base introspectada.
model BackendHealthcheck {
  id        String   @id @default(uuid()) @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("backend_healthchecks")
  @@schema("public")
}

/// Sessões do backend. Não altera auth.users.
model BackendRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("backend_refresh_tokens")
  @@schema("public")
}

/// Pedidos de redefinição. O hash da senha só muda quando o token é consumido.
model BackendPasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("backend_password_resets")
  @@schema("public")
}
