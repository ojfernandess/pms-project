# Copie para backend/.env. Não commite segredos.
DATABASE_URL=postgresql://pms:pms@localhost:5432/pms
# Supabase: false. Postgres local vazio: true + SKIP_PRISMA_MIGRATE=false
PRISMA_MIGRATE_ON_START=false
SKIP_PRISMA_MIGRATE=true
REDIS_URL=redis://localhost:6379
PORT=3000
# Token de desenvolvimento do Socket.IO. Vazio = nenhuma ligação aceite.
SOCKET_AUTH_TOKEN=dev-socket-token
# Protege POST /internal/queues/ping
INTERNAL_API_TOKEN=dev-internal-token
# Segredo local. Troque antes de qualquer ambiente partilhado.
JWT_SECRET=local-development-jwt-secret-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# true só em desenvolvimento: devolve o token de reset na resposta.
PASSWORD_RESET_DEBUG=false
# Origem pública do Nest, usada em logos e links de e-mail. Ex.: https://app.seudominio.com
PUBLIC_APP_URL=
# Mantidos vazios. A sessão não volta a consultar o Auth do Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
