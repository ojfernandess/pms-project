# Frontend (pms-web) — Easypanel: variáveis de BUILD e de RUNTIME são separadas.

# ========== BUILD ARGS (obrigatório no painel Build / requer rebuild) ==========
# Vite embute VITE_* no bundle estático.

VITE_PMS_API_URL=https://app.seudominio.com
VITE_APP_URL=https://app.seudominio.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_SERVICE_ROLE_KEY=
VITE_USE_RATE_CALENDAR_SUMMARY=

# Modo A — mesmo domínio (recomendado): VITE_PMS_API_URL = VITE_APP_URL; nginx faz proxy para a API.
# Modo B — API em subdomínio: VITE_PMS_API_URL=https://api.seudominio.com e configure CORS_* no backend.

# ========== RUNTIME (container — sem rebuild, após imagem com runtime-config) ==========
# Geram /runtime-config.js na subida do contentor (ver deploy/frontend/40-generate-runtime-config.sh).
# Use estes nomes no Easypanel Environment; alternativa: PMS_API_URL / PMS_APP_URL
# Host interno do serviço backend na rede do projeto Easypanel (HTTP, porta da API).
# Exemplo: nome do serviço criado no painel + porta 3000.

BACKEND_UPSTREAM=http://backend:3000

# Domínio dedicado do Web Check-in (sem https://, sem barra). Gera runtime-config.webCheckinPublicHost
WEB_CHECKIN_PUBLIC_HOST=checkin.seudominio.com
# Modo checkin dedicado: pode usar VITE_PMS_API_URL=https://checkin.seudominio.com (proxy nginx) no rebuild
