# Worker (pms-worker) — mesma imagem que o backend; sem domínio/porta pública.
# OBRIGATÓRIO: PMS_RUN_MODE=worker (senão sobe a API de novo e esgota o pool Supabase).
PMS_RUN_MODE=worker

# Supabase: prefira pooler transaction :6543?pgbouncer=true (não session :5432 para app).
DATABASE_URL=postgresql://user:pass@HOST:6543/DATABASE?pgbouncer=true&connection_limit=2&pool_timeout=20
REDIS_URL=redis://redis:6379

JWT_SECRET=troque-por-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

SOCKET_AUTH_TOKEN=
INTERNAL_API_TOKEN=

PUBLIC_APP_URL=https://app.seudominio.com
SITE_URL=https://app.seudominio.com

# Não é necessário PRISMA_MIGRATE_ON_START no worker (só a API executa migrate no entrypoint).
