# PostgreSQL — só se criar banco gerido no Easypanel (opcional).
# Muitos deploys usam Supabase/pooler externo em DATABASE_URL sem contentor Postgres.

POSTGRES_USER=pms
POSTGRES_PASSWORD=troque-senha-forte
POSTGRES_DB=pms

# Connection string para backend/worker (rede interna):
# postgresql://pms:SENHA@postgres:5432/pms

# MIGRAÇÃO: não recrie volume nem apague dados ao mudar da stack Compose para serviço separado.
# Anexe o volume existente ou restaure backup antes de apontar DATABASE_URL.
