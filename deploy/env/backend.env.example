# Backend (pms-api) — variáveis de RUNTIME no Easypanel (serviço App separado).
# Não commitar valores reais. Ver backend/.env.example para descrição detalhada.

PORT=3000
NODE_ENV=production

# Postgres: URL pública do pooler ou host interno Easypanel (ex.: postgresql://user:pass@postgres:5432/pms)
# Supabase: use pooler TRANSACTION :6543 + pgbouncer=true (session :5432 limita ~15 clientes).
# Worker: PMS_RUN_MODE=worker e connection_limit=2. Senha com & ? # → URL-encode na URL.
DATABASE_URL=postgresql://user:pass@HOST:6543/DATABASE?pgbouncer=true&connection_limit=4&pool_timeout=20

# Supabase existente: false. Postgres Easypanel vazio: true (apenas 1º deploy), depois false
PRISMA_MIGRATE_ON_START=false

# --- Migração de dados Supabase → pms-postgres (no arranque do backend, sem comando manual) ---
# 1) DATABASE_URL = Postgres interno (ex.: postgresql://postgres:SENHA@projetolab_pms-postgres:5432/projetolab)
# 2) Schema no destino antes (PRISMA_MIGRATE_ON_START=true ou dump schema)
# 3) Destrave só no 1º restart; depois comente ou use once + remova SUPABASE_DATABASE_URL
# APP_IMPORT_SUPABASE_DATA=once
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres
# COPY_MODE=node
# APP_IMPORT_SCHEMA=from_supabase
# APP_IMPORT_RUN_BOOTSTRAP=true
# APP_IMPORT_STRICT=false   # true = falha o container se o import falhar
# 1) Schema completo (RPCs, reservations, stripe_*…): uma vez antes dos dados
# APP_IMPORT_SUPABASE_SCHEMA=once
# 2) Dados: force após schema; APP_IMPORT_SCHEMA=skip; descobrir todas as tabelas
# APP_IMPORT_SUPABASE_DATA=force   # remover após import OK (cada restart refaz TRUNCATE+129 tabelas!)
# APP_IMPORT_DISCOVER_TABLES=public,auth
# APP_IMPORT_SCHEMA=skip             # não usar from_supabase com discover
# PMS_IMPORT_IN_BACKGROUND=true      # API sobe enquanto copia dados (opcional)
#
# Após migração estável (pare o loop force / TRUNCATE):
# PMS_MIGRATION_COMPLETE=true
# Comente APP_IMPORT_SUPABASE_DATA, SUPABASE_DATABASE_URL, APP_APPLY_BUNDLED_RPCS=force
# Não combine PMS_MIGRATION_COMPLETE=true com APP_IMPORT_SUPABASE_DATA=force (TRUNCATE a cada restart)
# Easypanel: 1 réplica no backend durante import
# tuple concurrently updated = vários pods a correr grants/import em paralelo
# APP_RUN_DB_GRANTS=true    # uma vez após import: aplica GRANTs authenticated/anon
# APP_IMPORT_SYNC_FKS=true  # uma vez: copia FOREIGN KEYs da origem (embeds reservations->rooms)
# APP_IMPORT_SYNC_FUNCTIONS=true  # calculate_rate_price, cancel_expired_preregistrations, etc.
# SYNC_FUNCTIONS_CRITICAL_ONLY=true  # só RPCs críticas (import mais rápido)
# SYNC_FUNCTIONS_FORCE=true          # recria RPCs críticas no destino
#
# Bundled RPCs: auto (padrão) aplica SQL se calculate_rate_price faltar; force repete
# APP_APPLY_BUNDLED_RPCS=auto
# APP_APPLY_BUNDLED_RPCS=force
# APP_APPLY_BUNDLED_RPCS_STRICT=true  # falha o container se a RPC não instalar
# Com PMS_MIGRATION_COMPLETE=true, force é ignorado (use auto). Uma vez: PMS_ALLOW_BUNDLED_RPCS_FORCE=true
# PRISMA_CONNECT_RETRIES=10  # se "Engine is not yet connected" no arranque (Postgres ocupado)

# Postgres Easypanel (sem RLS Supabase completo): use service_role nas queries até migrar políticas
# PMS_DB_QUERY_ROLE=service_role

# Redis do projeto Easypanel (nome do serviço na rede interna)
REDIS_URL=redis://redis:6379

JWT_SECRET=troque-por-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

SOCKET_AUTH_TOKEN=
INTERNAL_API_TOKEN=

# URL pública do frontend (e-mails, links, CORS implícito)
PUBLIC_APP_URL=https://app.seudominio.com
SITE_URL=https://app.seudominio.com

# Opcional: origens extra se o browser usar domínio da API diferente do SPA
# CORS_ORIGINS=https://app.seudominio.com

PASSWORD_RESET_DEBUG=false
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Volume: montar em /app/storage se usar uploads locais
# STORAGE_DIR=/app/storage
